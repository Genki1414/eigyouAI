# 足場AI営業エンジン — 定期実行
# 送信は営業時間内に限定する。深夜・早朝のFAXは苦情に直結する。
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
TZ=Asia/Tokyo

# エンリッチメント: 毎日 深夜に500社ずつ。落ちても翌日続きから走る
# ※一時的に無効化中(2026-08-05)。実際にAnthropic APIを叩いて課金が発生するため、
#   まず手動で--limit 5等の少数実行→実測コスト確認を行ってから有効化すること。
#   詳細はHANDOFF.mdの運用ルール参照。
# 0 2 * * * cd /app && python3 enrich.py --limit 500 >> /app/out/cron.log 2>&1

# スコアリング: エンリッチ後に再計算
0 4 * * * cd /app && python3 scoring.py >> /app/out/cron.log 2>&1

# 送信: 平日の9時と14時のみ。土日祝は送らない
# flock -n: 前回の実行がまだ終わっていない場合は待たずに即座に諦める(多重起動防止)。
# 実サイトへのフォーム送信は取り消せないため、二重実行より「今回はスキップ」の方が安全
0 9,14 * * 1-5 cd /app && flock -n /tmp/eigyouai_send.lock python3 senders.py 1 1 >> /app/out/cron.log 2>&1

# フォローアップ: 平日10時。D+14/D+35の対象を生成して送る
0 10 * * 1-5 cd /app && python3 followup.py --campaign 1 --step 2 >> /app/out/cron.log 2>&1

# 予約送信・即時送信のキュー(scheduled_sends)はT91からdocker-compose.ymlのsenderサービス
# (scheduled_send_cli.py loop)が常駐で実行する。ここのcronからは外した(残すと
# workerコンテナ側でもChromiumが起動してメモリを取り合うため)。senderが止まって
# いる場合の保険として手動で `docker compose run --rm sender python3 scheduled_send_cli.py run-due`
# を実行できる(取り込みはアトミックなので二重実行にはならない)。

# 学習: 週次。昇格ゲートを通ればV2に切り替わる
0 3 * * 1 cd /app && python3 learn.py >> /app/out/cron.log 2>&1

# 集計とIM更新: 毎日
30 5 * * * cd /app && python3 metrics.py >> /app/out/cron.log 2>&1
40 5 * * * cd /app && python3 im.py > /app/out/IM.md 2>> /app/out/cron.log

# 法令遵守の監査: 毎日。異常があればログに残る
0 6 * * * cd /app && python3 suppress_cli.py check >> /app/out/audit.log 2>&1

# 監視・アラート: 30分おき。Kill Switch停止・配信停止遵守違反・フォーム送信
# 失敗率の上昇等を検知したらOPS_ALERT_EMAIL宛にメールで知らせる(T35)。
# 同じ異常を何度も検知しても、内部のクールダウン(60分)により再送はしない
# (アラート疲れ防止。monitor.py参照)。OPS_ALERT_EMAIL未設定時はcron.logに
# 出力するのみでメールは送らない。
*/30 * * * * cd /app && python3 monitor.py check >> /app/out/cron.log 2>&1

# 休眠プールの再投入判定: 毎週月曜
0 7 * * 1 cd /app && python3 dormant.py --campaign 1 --revive --dry >> /app/out/cron.log 2>&1

# バックアップ: 毎日。sqlite3.Connection.backup()による安全なスナップショット+
# 整合性チェック+14日分ローテーション(T36)。生ファイルコピーはWAL運用中に
# 書き込みと重なると壊れたスナップショットを作りかねないため廃止した。
# 成功時刻はout/backups/last_success.jsonに記録され、monitor.pyがこれを見て
# 一定時間(config.BACKUP_STALE_HOURS)成功していなければアラートする。
0 1 * * * cd /app && python3 backup.py run >> /app/out/cron.log 2>&1
