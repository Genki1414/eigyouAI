# ── 必須 ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
WEBHOOK_SECRET=          # openssl rand -hex 32 で生成。課金webhookの署名検証に使う

# ── Stock Factory連携(社長のRuntimeから叩く運用API) ──
# openssl rand -hex 32 で生成。/api/ops/status /api/ops/metrics /api/ops/run-step の
# Authorization: Bearer 認証に使う。未設定だとこれら3エンドポイントは常に401を返す。
SALES_ENGINE_API_KEY=

# ── データベース ──────────────────────
# 未設定ならSQLite（開発・単一プロセス）
# DATABASE_URL=postgresql://ashibase:PASSWORD@postgres:5432/ashibase
POSTGRES_PASSWORD=

# ── 送信 ─────────────────────────────
# メール送信(Resend。2026-09-09にSendGridから切替。姉妹プロジェクト
# 「足場屋革命」がashibase.jpドメインで既にCustom SMTP運用実績あり)
RESEND_API_KEY=
FAX_API_KEY=             # 秒速FAX / メッセージプラス等
FAX_API_URL=
SMS_API_KEY=

# ── フォーム送信の総量・ペーシング上限(config.py。T90) ──
# いずれも未設定または-1で無効(既定。2026-09-17ユーザー判断)。異常時に止めたい場合だけ
# 件数を入れる。テナントごとの枠(monthly/daily_send_quota)はこれとは別に常に効く。
FORM_MAX_PER_HOUR=-1              # 全テナント合算・直近1時間(例: 2000)
FORM_MAX_PER_DAY=-1               # 全テナント合算・直近24時間(例: 20000)
FORM_MAX_PER_RUN=-1               # 1回の実行(API呼び出し/cron1回)あたり(例: 50)
FORM_MAX_PER_TENANT_PER_HOUR=-1   # テナント1社・直近1時間(例: 50)

# ── リストの上限(target_lists.py。T92) ──
# リスト1件あたりの企業数(MAX_LIST_SIZE)とCSV取込の行数(MAX_CSV_ROWS)。
# 未設定または-1で無制限(既定。2026-09-17ユーザー判断)。
MAX_LIST_SIZE=-1
MAX_CSV_ROWS=-1

# ── 送信ワーカー(deploy/docker-compose.ymlのsenderサービス。T91) ──
# SENDER_WORKERS: 送信ワーカーのプロセス数。FORM_SEND_CONCURRENCY: 1プロセスあたりの
# 並列数(Chromium同時起動数)。サーバー全体の同時送信数=両者の積。メモリの目安は
# 1並列あたり約400MB。4GB→1×3、8GB→2×3、16GB→4×3。変更後は
# `docker compose -f deploy/docker-compose.yml up -d sender` で反映。
SENDER_WORKERS=1
FORM_SEND_CONCURRENCY=3
# SENDER_POLL_INTERVAL=15   # キューを見に行く間隔(秒)。既定15
# SENDER_MAX_ATTEMPTS=3     # 例外で落ちた予約を自動でやり直す回数(T98)。送信済みは飛ばして再開
# SENDER_STALL_MINUTES=20   # 処理数がこの分数増えなければ固まったとみなし子ワーカーを起動し直す(T98)

# ── 送信元IPの分散(プロキシ。form_navigator.py。T42) ──
# 未設定ならプロキシを使わず直接アクセスする(既定)。設定すると、フォーム自動送信
# (Playwright)がブラウザを起動するたびにこのプールからプロキシを1つランダムに選んで
# 経由する。カンマ区切りで複数指定可。認証が要る場合はURLにuser:passを埋め込む。
# 例: FORM_PROXY_POOL=http://user1:pass1@proxy1.example.com:8080,http://proxy2.example.com:8080
FORM_PROXY_POOL=

# ── 監視・アラート(monitor.py) ────────────────
# Kill Switch停止・配信停止遵守違反・フォーム送信失敗率上昇・バックアップ失敗等を
# 検知した際の通知先。未設定だと異常を検知してもメールは送らない(cron.logへの
# 出力のみ)。list_builder.htmlのプラン変更申請(T53)の通知先メールも兼ねる
# (未設定でも申請自体はDBに残り、hq.htmlの一覧から取りこぼさず確認できる)。
OPS_ALERT_EMAIL=

# ── バックアップのオフサイト複製(backup.py。T37) ──
# 未設定ならローカルディスク上のバックアップのみ(out/backups/)で運用する。
# 設定するとbackup.py run実行のたびにrsyncで複製する。Hetzner Storage Boxの
# 場合の書式・設定手順はbackup.pyの冒頭コメント参照。
# 例: BACKUP_OFFSITE_TARGET=u123456@u123456.your-storagebox.de:backups/
BACKUP_OFFSITE_TARGET=
BACKUP_OFFSITE_SSH_PORT=23

# ── 公開URL ───────────────────────────
LP_URL=https://ashibase.jp/sekisan
# このAPI自身の公開URL。担当者登録の認証メール本文に埋め込むリンク
# (GET /verify/staff/<token>)の組み立てに使う。EIGYOUAI_DOMAINと揃える
# (下のEIGYOUAI_DOMAIN例と同じくapp.ashibase.jpが実際の公開ドメイン)。
API_PUBLIC_URL=https://app.ashibase.jp
# クリック計測リンクの宛先。空ならAPI_PUBLIC_URLと同じになる。
# 別ドメイン(例: ashibase.jp)を書くとそのドメインでAPIが動いていない限り
# 計測リンクが繋がらないので注意(2026-09-20の実障害)
TRACK_BASE_URL=
# 配信停止URL。基本は空のままでよい(config.pyが↑のAPI_PUBLIC_URLから
# 自動的に正しいパス(/api/optout)を組み立てる)。ここを明示的に指定すると
# API_PUBLIC_URLと矛盾していても常にこちらの値が優先されてしまうので、
# 変更する場合はAPI_PUBLIC_URL/EIGYOUAI_DOMAINと必ず一致させること
# (2026-09-09: この値がapp.が抜けた旧ドメイン+旧パスのまま放置されており、
#  API_PUBLIC_URL側だけ直しても配信停止URLが404のままになる事故が実際に発生した)。
OPTOUT_URL=

# ── HTTPS化(deploy/Caddyfileが参照) ──────────
# list_builder.html / APIを公開するドメイン。事前にAレコードで
# このサーバーのグローバルIPへ向けておくこと(Let's Encryptのドメイン検証に必須)。
# 例: EIGYOUAI_DOMAIN=app.ashibase.jp
EIGYOUAI_DOMAIN=

# ── 送信者情報（特定電子メール法の表示義務） ──
SENDER_NAME=ヒラケル
SENDER_EMAIL=info@ashibase.jp
SENDER_ADDRESS=          # 登記上の住所。省略不可
